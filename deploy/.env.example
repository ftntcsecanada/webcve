# Copy to /data/projects/webcve/.env on the fabriclab host.
# Never commit the populated .env file.

WEBCVE_ALERT_WEBHOOK=
WEBCVE_ALERT_VENDORS=
WEBCVE_ALERT_MIN_SCORE=
WEBCVE_PUBLIC_URL=
GITHUB_TOKEN=

# Signature Lab backend proxy. The bearer token remains server-side and is
# never returned to the WebCVE browser application.
WEBCVE_SIGLAB_URL=http://10.160.12.103:16774
WEBCVE_SIGLAB_TOKEN=

# AI early-warning assessments (global-impact risk for critical CVEs), run on
# the private Bifrost gateway. Setting both BIFROST values turns them on; the
# rest are optional overrides.
# From the fabriclab host use the internal gateway: the public edge returns 403.
BIFROST_URL=http://10.160.20.209:8080
BIFROST_API_KEY=
WEBCVE_AI_MODEL=
WEBCVE_AI_TRIAGE_MODEL=
WEBCVE_AI_ESCALATE_AT=
WEBCVE_AI_MIN_SCORE=
WEBCVE_AI_TRIAGE_MIN_SCORE=
WEBCVE_AI_WINDOW_DAYS=
WEBCVE_AI_DAILY_LIMIT=
